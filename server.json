{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.NaNIsaac/codigest",
  "title": "Codigest",
  "description": "Terminal output, project snapshots and semantic diffs as LLM-ready context",
  "repository": {
    "url": "https://github.com/NaNIsaac/codigest",
    "source": "github"
  },
  "version": "0.4.3",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "codigest",
      "version": "0.4.3",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
